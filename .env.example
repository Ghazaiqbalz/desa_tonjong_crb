# WEBSITE_API_KEY: Required for website backend or third-party service integration.
# Configure this via your environment variables or host configuration.
WEBSITE_API_KEY="MY_WEBSITE_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
